# KMA Library - Production Environment Configuration Template
# Copy this file to .env.production and fill in the values
# NEVER commit .env.production to version control!

# ============================================
# Application
# ============================================
VERSION=main
# Host port on which the app (frontend nginx + /api proxy) is published
FRONTEND_PORT=8020
# Set to false to close registration after the family has accounts
APP_REGISTRATION_ENABLED=true
# External catalogs for ISBN lookup, asked in order until one finds the book.
# openlibrary needs no key; google works without a key but with a small shared quota. "none" = offline.
APP_CATALOG_PROVIDERS=openlibrary,google
# Optional Google Books API key (raises the quota; free, see docs/PHASE_6_SUMMARY.md)
APP_CATALOG_GOOGLE_API_KEY=

# ============================================
# Data Storage Path (Raspberry Pi SSD)
# ============================================
DATA_PATH=/mnt/kmalibrary-data

# ============================================
# PostgreSQL
# ============================================
POSTGRES_DB=kmalibrary
POSTGRES_USER=kmalibrary
# Use: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD

# ============================================
# JWT
# ============================================
# Use: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# ============================================
# CORS (comma separated origins)
# ============================================
# Normally not needed: the browser talks to /api on the same origin (frontend nginx proxies it)
# and the backend trusts X-Forwarded-* headers. Set it only if the API is called from another origin.
CORS_ALLOWED_ORIGINS=

# ============================================
# Backups
# ============================================
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/mnt/kmalibrary-data/backups

# ============================================
# Security Checklist
# ============================================
# [ ] Changed all default passwords
# [ ] Generated strong JWT secret
# [ ] Set correct CORS origins
# [ ] Configured external SSD path
# [ ] HTTPS in front of port 8020 (see docs/adr/002-https.md)
# [ ] Enabled automatic backups (scripts/backup-database.sh in cron)
# [ ] Changed the admin@example.com password after first login
